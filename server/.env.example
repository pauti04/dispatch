# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Server
PORT=5180
APP_URL=http://localhost:5173

# Postgres (Neon)
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Auth
JWT_SECRET=change-me-to-a-long-random-string

# Resend (transactional email)
RESEND_API_KEY=re_...
FROM_EMAIL=Dispatch <onboarding@resend.dev>

# Cron (protects /api/cron/dispatch from public hits)
CRON_SECRET=change-me-to-a-long-random-string

# Comma-separated list of emails allowed at /admin endpoints
ADMIN_EMAILS=

# Optional model overrides
OPENAI_JUDGE_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

# Brief generation tuning
BRIEF_PREFILTER_TOPN=30

# Slack OAuth (optional — Wave K)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:5180/api/slack/callback

# Observability — Wave N (all optional; silent no-ops when missing)
SENTRY_DSN=
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
RELEASE=

# Cost alerts — Wave N Day 2
COST_ALERT_THRESHOLD_USD=5.00
COST_ALERT_WEBHOOK_URL=
